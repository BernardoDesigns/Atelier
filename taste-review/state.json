    "taste.md#T34": {
      "status": "rewritten",
      "text": "Surface exceptions as gentle nudges, not blockers.",
      "updated": "2026-11-20",
      "fields": {
        "Applied as": "Update local state immediately, persist in the background, always provide undo."
      }
    },
    "taste.md#T35": {
